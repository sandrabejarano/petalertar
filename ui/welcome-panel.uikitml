<!--
  Bienvenida DENTRO de AR (aparece en el espacio real despues del logo animado: src/estaciones/intro-screen.js).
  Estilo de las tarjetas del proyecto anterior (Pet Alert, css/04-tooltip.css): azul clarito, borde blanco, etiqueta en
  coral, titulo en Varela Round azul marino, texto en Barlow y boton en pildora azul marino. Viñetas con punto coral.
    welcome-start  boton COMENZAR (se toca con el dedo indice). Iconos Lucide: ArrowRight.
-->
<style>
  @font-face {
    font-family: Barlow;
    src: url(../fonts/Barlow_400Regular.ttf);
  }

  @font-face {
    font-family: Barlow;
    src: url(../fonts/Barlow_700Bold.ttf);
    font-weight: bold;
  }

  @font-face {
    font-family: VarelaRound;
    src: url(../fonts/VarelaRound_400Regular.ttf);
  }

  .card {
    flex-direction: column;
    width: 460px;
    padding-top: 30px;
    padding-left: 34px;
    padding-right: 34px;
    padding-bottom: 28px;
    gap: 10px;
    border-radius: 30px;
    border-width: 3px;
    border-color: #ffffff;
    background-color: #dcebfb;
    font-family: Barlow;
  }

  .num {
    color: #ff7a66;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1.2px;
  }

  .title {
    font-family: VarelaRound;
    color: #14305e;
    font-size: 34px;
    line-height: 40px;
  }

  .text {
    color: #3b5683;
    font-size: 20px;
    line-height: 28px;
  }

  .list {
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .item {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }

  .dot {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border-radius: 6px;
    background-color: #ff7a66;
  }

  .item-text {
    color: #14305e;
    font-size: 20px;
    line-height: 26px;
    flex-shrink: 1;
  }

  .btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-radius: 32px;
    background-color: #14305e;
    cursor: pointer;
  }

  .btn:hover {
    background-color: #24508f;
  }

  .btn-label {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 1.4px;
  }
</style>
<div class="card">
  <span class="num">KIT DE EMERGENCIA</span>
  <span class="title">Cuida a tus mascotas</span>
  <span class="text">Prepárate para proteger a tu perro y a tu gato antes de un sismo, aquí, en tu propio espacio. Todo se hace con tus manos.</span>
  <div class="list">
    <div class="item"><div class="dot"></div><span class="item-text">Saluda a Cacao y Nube y acarícialos.</span></div>
    <div class="item"><div class="dot"></div><span class="item-text">Mira un espacio libre del piso: ahí aparecerá el kit.</span></div>
    <div class="item"><div class="dot"></div><span class="item-text">Toca con el dedo un objeto que brilla para conocerlo.</span></div>
    <div class="item"><div class="dot"></div><span class="item-text">Tómalo con la pinza, llévalo al maletín y suéltalo para guardarlo.</span></div>
  </div>
  <div id="welcome-start" class="btn">
    <span class="btn-label">COMENZAR</span>
    <ArrowRight width="22" height="22" color="#ffffff"></ArrowRight>
  </div>
</div>
