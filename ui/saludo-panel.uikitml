<!--
  Saludo de las mascotas (src/mascotas/saludo.js): aparece sobre Cacao y Nube justo despues de la bienvenida, antes de buscar el
  lugar del kit. Mismo estilo que la bienvenida (azul clarito, borde blanco, etiqueta coral, Varela Round + Barlow, pildora azul marino).
    saludo-estado     texto que cambia: invitacion a acariciar / "Que rico" mientras las acarician / a cual falta / "Les encanto"
    saludo-continuar  boton CONTINUAR, OCULTO: el saludo avanza solo al acariciar a las dos mascotas; el boton solo aparece
                      como respaldo si pasa un buen rato sin lograrlo (se toca con el dedo indice o con el rayo)
  Iconos Lucide: Heart, ArrowRight.
-->
<style>
  @font-face {
    font-family: Barlow;
    src: url(../fonts/Barlow_400Regular.ttf);
  }

  @font-face {
    font-family: Barlow;
    src: url(../fonts/Barlow_700Bold.ttf);
    font-weight: bold;
  }

  @font-face {
    font-family: VarelaRound;
    src: url(../fonts/VarelaRound_400Regular.ttf);
  }

  .card {
    flex-direction: column;
    width: 460px;
    padding-top: 28px;
    padding-left: 34px;
    padding-right: 34px;
    padding-bottom: 26px;
    gap: 10px;
    border-radius: 30px;
    border-width: 3px;
    border-color: #ffffff;
    background-color: #dcebfb;
    font-family: Barlow;
  }

  .num {
    color: #ff7a66;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1.2px;
  }

  .title {
    font-family: VarelaRound;
    color: #14305e;
    font-size: 34px;
    line-height: 40px;
  }

  .text {
    color: #3b5683;
    font-size: 20px;
    line-height: 28px;
  }

  .estado {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    margin-top: 4px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 18px;
    background-color: #ffffff;
  }

  .badge {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background-color: #ff7a66;
  }

  .estado-text {
    color: #14305e;
    font-size: 20px;
    line-height: 26px;
    flex-shrink: 1;
  }

  .btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-radius: 32px;
    background-color: #14305e;
    cursor: pointer;
  }

  .btn:hover {
    background-color: #24508f;
  }

  .btn-label {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 1.4px;
  }
</style>
<div class="card">
  <span class="num">TUS COMPAÑEROS</span>
  <span class="title">¡Hola! Somos Cacao y Nube</span>
  <span class="text">Cacao, un perro juguetón, y Nube, una gata curiosa, te acompañarán en esta experiencia. ¡Salúdalos!</span>
  <div class="estado">
    <div class="badge"><Heart width="26" height="26" color="#ffffff"></Heart></div>
    <span id="saludo-estado" class="estado-text">Acaricia a tus mascotas: pon tu mano sobre su cabeza.</span>
  </div>
  <div id="saludo-continuar" class="btn" style="display: none">
    <span class="btn-label">CONTINUAR</span>
    <ArrowRight width="22" height="22" color="#ffffff"></ArrowRight>
  </div>
</div>
